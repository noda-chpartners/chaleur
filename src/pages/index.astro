---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LineCta from '../components/LineCta.astro';
import '../assets/styles/home.scss';

import checkBack from '../assets/images/line_oa_chat_261006_120835.jpg';
import chairSpine from '../assets/images/line_oa_chat_261006_120807.jpg';
import pelvisGuide from '../assets/images/1789434548.png';
import standingLine from '../assets/images/line_oa_chat_261006_120810.jpg';
import shoulderBack from '../assets/images/line_oa_chat_261006_120830.jpg';
import studio from '../assets/images/line_oa_chat_261006_120823.jpg';
import sessionTalk from '../assets/images/line_oa_chat_261006_120819.jpg';
import profileScene from '../assets/images/line_oa_chat_261006_120839.jpg';

const hpUrl = 'https://sites.google.com/view/chaleur-shisei/%E3%83%9B%E3%83%BC%E3%83%A0';

const pageTitle = '川口の姿勢サロン しゃるーる｜疲れた日でも、1日10分から';
const pageDescription =
	'川口市並木の姿勢サロン「しゃるーる」（Chaleur）。疲れた日でも、1日10分から。姿勢・背中・ヒップの美軸を知る無料5大特典を、公式LINEで受け取れます。';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HealthAndBeautyBusiness',
	name: '姿勢サロン しゃるーる',
	alternateName: 'Chaleur',
	description: pageDescription,
	telephone: '+81484440647',
	url: hpUrl,
	sameAs: ['https://www.instagram.com/chaleur_bishisei', hpUrl],
	address: {
		'@type': 'PostalAddress',
		streetAddress: '並木1-9-11',
		addressLocality: '川口市',
		addressRegion: '埼玉県',
		addressCountry: 'JP',
	},
	areaServed: {
		'@type': 'City',
		name: '川口市',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '19:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'PublicHolidays'],
			opens: '10:00',
			closes: '18:00',
		},
	],
};

const concerns = [
	{
		num: '01',
		title: 'マッサージをしても、すぐ戻る',
		text: 'ほぐしたあとに、また肩や腰が重くなる。背骨と骨盤、足の重心がずれたまま過ごしているのかもしれません。',
	},
	{
		num: '02',
		title: '後ろ姿に、自信が持てない',
		text: '背中の丸み、首元、腰まわり。自分では見えない場所にこそ、疲れは出やすいものです。',
	},
	{
		num: '03',
		title: '肩や腰の重さが、いつもの景色',
		text: 'その重さを、いったん預ける場所がほしい。まずは自分の姿勢の癖に気づくことから始められます。',
	},
	{
		num: '04',
		title: '頑張っても、身体がついてこない',
		text: '激しく追い込む必要はありません。歪みに気づき、日常で使える感覚を思い出していくことが、しゃるーるの考え方です。',
	},
];

const gifts = [
	{
		num: '01',
		title: '3分でわかる！美軸姿勢セルフチェック',
		doing: '横と後ろから、頭・肩・骨盤・足の位置を見ていきます。目安は3分です。',
		notice: '体重がどちらの足に乗っているか、肩が内側に入っていないか。自分の美軸の現在地がわかります。',
		note: 'からだの状態を知るためのチェックです。診断ではありません。',
		image: checkBack,
		alt: '後ろから肩と腰の位置を確かめる立ち姿',
		caption: '後ろから、自分のラインを見る',
	},
	{
		num: '02',
		title: 'イスでできる「腸腰筋＆背骨」エクササイズ',
		doing: '椅子に座ったまま、股関節の前側（腸腰筋）と背骨を、ゆっくり動かします。',
		notice: '座りっぱなしで固まりやすい脚の付け根と、丸まりやすい背中が、どのようにつながっているかに気づきます。',
		note: 'この回は、椅子に座って行います。',
		image: chairSpine,
		alt: '椅子に座って背骨を伸ばしている様子',
		caption: '椅子に座って、背骨を動かす',
	},
	{
		num: '03',
		title: 'イス＋ペットボトルでできる「骨盤底筋」エクササイズ',
		doing: '椅子に座り、ご自宅のペットボトルを支えにしながら、骨盤底筋へ意識を向けて小さく動かします。',
		notice: '息を吐いたときの骨盤の位置と、下腹部の力の入れ具合がわかります。',
		note: '強い負荷は使いません。写真は骨盤の位置に意識を向けている様子です。特典そのものは、椅子とペットボトルで行います。',
		image: pelvisGuide,
		alt: '骨盤の位置に手を添え、姿勢を見ている様子',
		caption: '骨盤の位置に、意識を向ける',
	},
	{
		num: '04',
		title: '重心から変える「立ち方・歩き方」',
		doing: '足裏のどこに体重があるかを手がかりに、立ち方と歩き方を見直します。',
		notice: '骨盤の位置と、足の着き方。日常の一歩で思い出せるポイントが見つかります。',
		note: '',
		image: standingLine,
		alt: '横から見た、頭・肩・骨盤・足がつながる立ち姿',
		caption: '横から、立ち方の軸を見る',
	},
	{
		num: '05',
		title: '肩まわりスッキリストレッチ',
		doing: '肩甲骨のまわりを、気持ちのよい範囲でゆっくり伸ばします。',
		notice: '肩が前に入っている感覚と、肩の位置が戻ったときの背中の広がりがわかります。',
		note: '',
		image: shoulderBack,
		alt: '後ろから見た、肩甲骨まわりの立ち姿',
		caption: '肩甲骨のまわりを、ゆっくり伸ばす',
	},
];

const homeSteps = [
	{
		num: '01',
		title: '気づく',
		text: 'まずはセルフチェック。頭、肩、骨盤、足が、今どこにあるかを知ります。',
	},
	{
		num: '02',
		title: 'その日のひとつを選ぶ',
		text: '椅子で背骨を動かす日、ペットボトルを添えて骨盤底筋を感じる日、立ち方を思い出す日。全部を一度にやらなくて大丈夫です。',
	},
	{
		num: '03',
		title: '10分を目安に続ける',
		text: '「1日10分」は、習慣の目安です。疲れた日はもっと短く、余裕のある日は少し丁寧に。動画の長さは内容ごとに違います。',
	},
];

const receiveSteps = [
	{
		num: '01',
		title: '公式LINEを開く',
		text: 'このページのボタンから、しゃるーるの公式LINEへ進みます。',
	},
	{
		num: '02',
		title: '友だち追加をする',
		text: '追加すると、トーク画面でご案内が届きます。',
	},
	{
		num: '03',
		title: '無料5大特典を受け取る',
		text: 'セルフチェック、腸腰筋と背骨、骨盤底筋、立ち方・歩き方、肩まわり。ページと同じ名称でお届けします。',
	},
];
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
	<main id="main">
		<section class="hero" id="top">
			<span class="hero__bubble hero__bubble--lg" aria-hidden="true"></span>
			<span class="hero__bubble hero__bubble--md" aria-hidden="true"></span>
			<span class="hero__bubble hero__bubble--sm" aria-hidden="true"></span>
			<div class="hero__stage">
				<figure class="hero__portrait">
					<Image
						src={checkBack}
						alt="後ろから見た、肩と背中のライン"
						widths={[480, 768, 1200]}
						sizes="(max-width: 1279px) 62vw, 34vw"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
				<h1 class="hero__panel">
					<span>疲れた日でも</span>
					<span>１日１０分から</span>
				</h1>
				<p class="hero__lines">
					<span>姿勢をシュッと</span>
					<span>背中をシュッと</span>
					<span>ヒップをキュッと</span>
				</p>
				<figure class="hero__thumb hero__thumb--wide">
					<Image
						src={studio}
						alt="木の床と鏡のあるスタジオ"
						widths={[360, 640]}
						sizes="(max-width: 1279px) 46vw, 28vw"
						quality={74}
					/>
				</figure>
				<figure class="hero__thumb hero__thumb--small">
					<Image
						src={chairSpine}
						alt="椅子に座って背骨を動かしている様子"
						widths={[320, 560]}
						sizes="(max-width: 1279px) 36vw, 22vw"
						quality={74}
					/>
				</figure>
				<p class="hero__scroll" aria-hidden="true">scroll</p>
				<a class="hero__fab" href="https://lin.ee/WXtAYwP" target="_blank" rel="noopener noreferrer">
					<span>美軸の<br />無料5大特典を<br />LINEで<br />受け取る</span>
				</a>
			</div>
		</section>

		<section class="section concerns" id="concerns">
			<div class="concerns__head" data-reveal>
				<p class="eyebrow">For you</p>
				<h2 class="heading">こんな感覚を、<br />抱えていませんか。</h2>
				<p class="lead">
					家事に、仕事に、誰かのために。身体のことは、あとまわしになりやすいものです。気になっている箇所が、ひとつでもあれば、そこが入り口です。
				</p>
			</div>
			<ol class="concerns__list">
				{
					concerns.map((item) => (
						<li class="concerns__item" data-reveal>
							<span class="concerns__num">{item.num}</span>
							<div>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section class="section gifts" id="gifts">
			<div class="gifts__head" data-reveal>
				<p class="eyebrow">Five gifts</p>
				<h2 class="heading">公式LINEで届く、<br />美軸の無料5大特典。</h2>
			</div>
			<div class="gifts__list">
				{
					gifts.map((gift) => (
						<article class="gift" data-reveal>
							<figure class="gift__photo">
								<Image
									src={gift.image}
									alt={gift.alt}
									widths={[480, 800, 1200]}
									sizes="(max-width: 1080px) 92vw, 38vw"
									quality={76}
								/>
								<figcaption>{gift.caption}</figcaption>
							</figure>
							<div class="gift__body">
								<span class="gift__num">{gift.num}</span>
								<h3>{gift.title}</h3>
								<p class="gift__label">やること</p>
								<p>{gift.doing}</p>
								<p class="gift__label">気づけること</p>
								<p>{gift.notice}</p>
								{gift.note && <p class="gift__note">{gift.note}</p>}
							</div>
						</article>
					))
				}
			</div>
			<div class="gifts__cta" data-reveal>
				<p>5つそろった状態で、公式LINEからお渡しします。</p>
				<LineCta />
			</div>
			<aside class="gifts__scope" data-reveal>
				<p class="gifts__scope-title">特典のご用意・配布について</p>
				<p>
					弊社では、特典そのものの作成および<br class="gifts__scope-break" />
					<span class="gifts__scope-keep">公式LINEでの特典送付・配布設定は</span><wbr /><span class="gifts__scope-keep">対応いたしかねます。</span><br />
					こちらはお客様側での<wbr /><span class="gifts__scope-keep">ご準備・ご対応をお願いいたします。</span>
				</p>
			</aside>
		</section>

		<section class="section home" id="home">
			<div class="home__head" data-reveal>
				<p class="eyebrow">At home</p>
				<h2 class="heading">自宅では、<br />その日の自分に合わせて。</h2>
				<p class="lead">
					「1日10分」は、続けるときの目安です。動画ごとに長さは違い、椅子を使うもの、ペットボトルを添えるもの、立って歩くものがあります。
				</p>
			</div>
			<ol class="home__list">
				{
					homeSteps.map((step) => (
						<li class="home__item" data-reveal>
							<span>{step.num}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
			<p class="home__aside" data-reveal>
				服装は普段着のままで大丈夫です。ペットボトルは、ご自宅にあるもので足ります。特別な日を待たず、今の体調で選べます。
			</p>
		</section>

		<section class="section concept" id="concept">
			<div class="concept__grid">
				<div class="concept__copy" data-reveal>
					<p class="eyebrow">Chaleur</p>
					<h2 class="heading">温かさを、<br />身体の軸から。</h2>
					<p class="concept__quote">
						しゃるーるは、フランス語で「温かさ」。<br />
						身体を追い込む場所ではなく、<br />
						自分の軸に気づき、日常へ持ち帰れる場所でありたい。
					</p>
					<div class="concept__body">
						<p>
							自分を大切にできるようになると、家族や大切な人にも、もっと優しくなれる。その笑顔が周りにも広がっていく。一人の温かさが、その人の大切な人へ、そしてその先へ。そう願って、この名前をつけました。
						</p>
						<p>
							美軸とは、頭・背骨・骨盤が、無理のない位置でつながっている状態のこと。まずは知ることから。整え方は、今の身体に合わせます。
						</p>
					</div>
				</div>
				<figure class="concept__photo" data-reveal>
					<Image
						src={studio}
						alt="木の床と鏡のある、しゃるーるのスタジオ"
						widths={[640, 960, 1400]}
						sizes="(max-width: 1080px) 92vw, 46vw"
						quality={76}
					/>
				</figure>
			</div>
		</section>

		<section class="section voice" id="voice">
			<div class="voice__head" data-reveal>
				<p class="eyebrow">Voice</p>
				<h2 class="heading">体験された方の声。</h2>
				<p class="voice__note">掲載している感想は、個人の体験です。身体の変化や痛みの改善を保証するものではありません。</p>
			</div>
			<div class="voice__layout">
				<figure class="voice__photo" data-reveal>
					<Image
						src={sessionTalk}
						alt="テーブルをはさんで姿勢の話をしている様子"
						widths={[480, 800, 1200]}
						sizes="(max-width: 1080px) 92vw, 40vw"
						quality={76}
					/>
					<figcaption>体験の様子</figcaption>
				</figure>
				<div class="voice__quotes">
					<blockquote class="voice__card" data-reveal>
						<p>
							マッサージに通っても、数日で戻る感じが気になっていました。重心や姿勢の癖を知るようになってから、自分で姿勢を思い出そうという気持ちになりました。
						</p>
						<footer>会社員の方の個人の感想</footer>
					</blockquote>
					<blockquote class="voice__card" data-reveal>
						<p>
							試着室で自分の後ろ姿を見たことが、姿勢を意識するきっかけでした。肩や骨盤の位置を知るうち、服を選ぶときの見方が変わり、着替える時間が楽しみになっています。
						</p>
						<footer>個人の感想</footer>
					</blockquote>
				</div>
			</div>
		</section>

		<section class="section profile" id="profile">
			<div class="profile__grid">
				<figure class="profile__photo" data-reveal>
					<Image
						src={profileScene}
						alt="指導中の代表が、斜め前からゲストと向き合っている様子"
						widths={[480, 800, 1200]}
						sizes="(max-width: 1080px) 92vw, 42vw"
						quality={76}
					/>
				</figure>
				<div class="profile__copy" data-reveal>
					<p class="eyebrow">Profile</p>
					<h2 class="heading">私が、しゃるーるを<br />始めた理由。</h2>
					<p class="profile__name">
						<strong>Aya Nakagawa</strong>
						<span>代表 / 姿勢改善専門家　トレーナー歴15年</span>
					</p>
					<div class="profile__body">
						<p>
							シングルマザーとして17年、子育てと仕事に追われる日々を歩んできました。30代までは頑張ればなんとかなると思い、身体を追い込んでいました。40代後半、強い疲労感や長引く不調、隠しきれない体型の崩れに直面したとき、「このまま追い込むだけでいいのだろうか」と立ち止まりました。
						</p>
						<p>
							出会ったのは、無理に鍛えるのではなく、骨格や股関節の歪みを整え、正しく身体を使えるようにするコンディショニング。身体の使い方が変わると、心まで晴れやかになっていくのを、私自身が実感しました。
						</p>
						<p>
							年齢で線を引かず、ご自身の身体と丁寧に向き合ってほしい。それが、しゃるーるで大切にしていることです。疲れた日は短く、余裕のある日は少し丁寧に。美軸を知るところから、一緒に始めていきましょう。
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section receive" id="receive">
			<div class="receive__inner" data-reveal>
				<p class="eyebrow">How to receive</p>
				<h2 class="heading">特典の受け取り方。</h2>
				<p class="lead">ボタンの先は、すべて同じ公式LINEです。登録後、無料5大特典をトークで受け取れます。</p>
				<ol class="receive__steps">
					{
						receiveSteps.map((step) => (
							<li>
								<span>{step.num}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.text}</p>
								</div>
							</li>
						))
					}
				</ol>
				<LineCta />
				<div class="receive__hp">
					<p>サロンのご案内は、ホームページをご覧ください。</p>
					<a class="btn btn--ghost" href={hpUrl} target="_blank" rel="noopener noreferrer">ホームページを見る</a>
				</div>
				<aside class="receive__scope">
					<p class="receive__scope-title">特典のご用意・配布について</p>
					<p>
						弊社では、特典そのものの作成および公式LINEでの特典送付・配布設定は対応いたしかねます。こちらはお客様側でのご準備・ご対応をお願いいたします。
					</p>
				</aside>
			</div>
		</section>
	</main>
</Layout>
