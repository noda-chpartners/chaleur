---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import LineCta from '../components/LineCta.astro';
import '../assets/styles/home.scss';

import chair from '../assets/images/chair.jpg';
import chairExercise from '../assets/images/chairtaisou.jpg';
import giftGuide from '../assets/images/tokuten.jpg';
import studio from '../assets/images/line_oa_chat_261006_120823.jpg';
import sessionTalk from '../assets/images/line_oa_chat_261006_120819.jpg';
import profileScene from '../assets/images/line_oa_chat_261006_120839.jpg';

const hpUrl = 'https://sites.google.com/view/chaleur-shisei/%E3%83%9B%E3%83%BC%E3%83%A0';

const pageTitle = '川口の姿勢サロン しゃるーる｜きれいな姿勢、1日5分のセルフケアから';
const pageDescription =
	'川口市並木の姿勢サロン「しゃるーる」（Chaleur）。きれいな姿勢、私にもできることから。1日5分、セルフケア。座ってできるセルフケアと姿勢骨格診断の無料3大特典を、公式LINEで受け取れます。';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HealthAndBeautyBusiness',
	name: '姿勢サロン しゃるーる',
	alternateName: 'Chaleur',
	description: pageDescription,
	telephone: '+81484440647',
	url: hpUrl,
	sameAs: ['https://www.instagram.com/chaleur_bishisei', hpUrl],
	address: {
		'@type': 'PostalAddress',
		streetAddress: '並木1-9-11',
		addressLocality: '川口市',
		addressRegion: '埼玉県',
		addressCountry: 'JP',
	},
	areaServed: {
		'@type': 'City',
		name: '川口市',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '19:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'PublicHolidays'],
			opens: '10:00',
			closes: '18:00',
		},
	],
};

const concerns = [
	{
		num: '01',
		title: '楽になったと思っても、またつらくなる',
		text: 'マッサージのあとは楽なのに、数日たつと肩や腰が重くなる、ずっとこの繰り返し',
	},
	{
		num: '02',
		title: '写真に映った姿勢に、がっかりする',
		text: '「私、こんなに背中が丸かった？」\n背すじを伸ばしてみても、気づくといつもの姿勢に戻っている。',
	},
	{
		num: '03',
		title: 'やりたいことはあるのに、身体が疲れてしまう',
		text: '仕事や家事を終えると、もうぐったり。\nお出かけや好きなことを楽しむ元気まで、残っていない。',
	},
	{
		num: '04',
		title: '変わりたい。でも、何から始めたらいいかわからない',
		text: 'ストレッチも運動も、いろいろ試してきた。今度こそ、私に合う方法を見つけたい。',
	},
	{
		num: '05',
		title: '「年齢のせい」と、諦めかけている',
		text: '前より疲れやすい。\n姿勢も体型も変わってきた。\n「仕方ない」と思いながらも、本当はまだ、きれいで元気に過ごしたい。',
	},
];

const gifts = [
	{
		num: '01',
		title: '椅子でできる腸腰筋背骨エクササイズ',
		text: '',
		effects: [
			'固まって動かなくなった腸腰筋を目覚めさせる',
			'背骨をしなやかに動かせるようにする',
			'体幹の筋膜リリース',
		],
		after: 'この3つの効果があります。',
	},
	{
		num: '02',
		title: '椅子、ペットボトルでできる内転筋エクササイズ',
		text: '内転筋は太ももの内側にある筋肉です。',
		effects: [
			'O脚Ｘ脚が改善される',
			'内もとが引き締まる',
			'骨盤底筋も同時に働くため、尿漏れ予防になる',
		],
		after: '',
	},
	{
		num: '03',
		title: '姿勢骨格診断',
		text: 'LINEで写真を送っていただき、姿勢分析を行い、改善のためのアドバイスをお伝えいたします。',
		effects: [],
		after: '',
	},
];

const homeSteps = [
	{
		num: '01',
		title: 'がんばりすぎない',
		text: 'がんばりすぎて、力が入ってしまうと、腸腰筋に刺激が届きません。\nできるだけ脱力して行います',
	},
	{
		num: '02',
		title: '呼吸を止めない',
		text: '呼吸が止まると、筋肉が固まり効果が半減してしまいます。',
	},
	{
		num: '03',
		title: '完璧を目指さない',
		text: 'できない日があってもいい。\nただ、できる日に必ずやろう',
	},
	{
		num: '04',
		title: '3週間続ける',
		text: '最初の3週間はほとんど変化を感じないかもしれません。\n3週間を超えたあたりから、ふと変化に気づきます。そこからが本当の始まり。\n3週間、信じて続けてください',
	},
];

const receiveSteps = [
	{
		num: '01',
		title: '公式LINEを開く',
		text: 'このページのボタンから、しゃるーるの公式LINEへ進みます。',
	},
	{
		num: '02',
		title: '友だち追加をする',
		text: '追加すると、トーク画面でご案内が届きます。',
	},
	{
		num: '03',
		title: '無料3大特典を受け取る',
		text: '椅子でできる腸腰筋背骨エクササイズ、椅子とペットボトルでできる内転筋エクササイズ、姿勢骨格診断をご案内します。',
	},
];
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
	<main id="main">
		<section class="hero" id="top">
			<span class="hero__bubble hero__bubble--lg" aria-hidden="true"></span>
			<span class="hero__bubble hero__bubble--md" aria-hidden="true"></span>
			<span class="hero__bubble hero__bubble--sm" aria-hidden="true"></span>
			<div class="hero__stage">
				<figure class="hero__portrait">
					<Image
						src={chair}
						alt="セルフケアに使う椅子とペットボトル"
						widths={[480, 768, 1200]}
						sizes="(max-width: 767px) 90vw, 42vw"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
				<div class="hero__copy">
					<h1 class="hero__panel">
						<span>きれいな姿勢、</span>
						<span>私にもできることから。</span>
						<span class="hero__daily">１日５分、セルフケア。</span>
					</h1>
					<p class="hero__lines">
						<span>姿勢をスッと</span>
						<span>背中をシュッと</span>
						<span>ヒップをキュッと</span>
					</p>
				</div>
				<p class="hero__scroll" aria-hidden="true">scroll</p>
				<a class="hero__fab" href="https://lin.ee/WXtAYwP" target="_blank" rel="noopener noreferrer">
					<span>美軸の<br />無料3大特典を<br />LINEで<br />受け取る</span>
				</a>
			</div>
		</section>

		<section class="section concerns" id="concerns">
			<div class="concerns__head" data-reveal>
				<p class="eyebrow">For you</p>
				<h2 class="heading">こんな気持ち、ありませんか？</h2>
				<p class="lead">
					家事に、仕事に、誰かのために。身体のことは、あとまわしになりやすいものです。気になっている箇所が、ひとつでもあれば、そこが入り口です。
				</p>
			</div>
			<ol class="concerns__list">
				{
					concerns.map((item) => (
						<li class="concerns__item" data-reveal>
							<span class="concerns__num">{item.num}</span>
							<div>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section class="section gifts" id="gifts">
			<div class="gifts__head" data-reveal>
				<p class="eyebrow">Three gifts / 無料3大特典</p>
				<h2 class="heading">身体を楽にしたい。<br />姿勢もきれいにしたい。<br />でも、何から始めたらいいかわからない。</h2>
				<p class="lead">そんなあなたが、おうちで一歩を踏み出せるように。<br />座ってできるセルフケアと姿勢骨格診断を無料特典にまとめました。</p>
			</div>
			<div class="gifts__list">
				{
					gifts.map((gift) => (
						<article class="gift" data-reveal>
							{gift.num === '02' && (
								<figure class="gift__photo">
									<Image
										src={chairExercise}
										alt="椅子に座り、両手を頭の後ろに添えてエクササイズをしている様子"
										widths={[480, 800, 1200]}
										sizes="(max-width: 767px) 90vw, 38vw"
										quality={76}
									/>
								</figure>
							)}
							<div class="gift__body">
								<span class="gift__num">{gift.num}</span>
								<h3>{gift.title}</h3>
								{gift.text && <p>{gift.text}</p>}
								{gift.effects.length > 0 && (
									<>
										<p class="gift__label">効果</p>
										<ul class="gift__effects">
											{gift.effects.map((effect) => <li>{effect}</li>)}
										</ul>
									</>
								)}
								{gift.after && <p class="gift__after">{gift.after}</p>}
							</div>
						</article>
					))
				}
			</div>
			<div class="gifts__cta" data-reveal>
				<p>3つの無料特典を、公式LINEでご案内します。</p>
				<LineCta />
			</div>
			<aside class="gifts__scope" data-reveal>
				<p class="gifts__scope-title">特典のご用意・配布について</p>
				<p>
					弊社では、特典そのものの作成および<br class="gifts__scope-break" />
					<span class="gifts__scope-keep">公式LINEでの特典送付・配布設定は</span><wbr /><span class="gifts__scope-keep">対応いたしかねます。</span><br />
					こちらはお客様側での<wbr /><span class="gifts__scope-keep">ご準備・ご対応をお願いいたします。</span>
				</p>
			</aside>
		</section>

		<section class="section home" id="home">
			<div class="home__head" data-reveal>
				<p class="eyebrow">At home</p>
				<h2 class="heading">おうちでできることから。<br />美軸セルフケアのポイント</h2>
			</div>
			<ol class="home__list">
				{
					homeSteps.map((step) => (
						<li class="home__item" data-reveal>
							<span>{step.num}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="section concept" id="concept">
			<div class="concept__grid">
				<div class="concept__copy" data-reveal>
					<p class="eyebrow">Chaleur</p>
					<h2 class="heading">きれいな姿勢も、疲れにくい身体も。<br />身体の使い方を学ぶことから。</h2>
					<div class="concept__body">
						<p>
							しゃるーるが考える「正しい姿勢」は、<br />
							胸を張ったり、背すじを無理に伸ばしたりして<br />
							頑張ってつくる形ではありません。
						</p>
						<p>
							目指すのは、余計な力に頼らず、<br />
							身体に負担の少ない位置で立ち、動けること。
						</p>
						<p>
							そのために、つらい場所だけを見るのではなく、<br />
							重心や、背骨・骨盤・股関節の動き、<br />
							日々の身体の使い方を確認します。
						</p>
						<p>
							まずは、動きやすい土台を整える。<br />
							そして、整えた身体をどう使うかを学ぶ。
						</p>
						<p>
							レッスンで感じたことを、<br />
							おうちでの１日１０分につなげ、<br />
							立つ・座る・歩くといった毎日の動きに<br />
							少しずつ取り入れていきます。
						</p>
						<p>
							整えてもらうだけでなく、<br />
							身体を知り、自分で整えられるようになる。
						</p>
						<p>
							一人ひとりの悩みや目標に寄り添い、<br />
							無理のないペースで、<br />
							美しさと動きやすさの両方を育てていく。
						</p>
						<p>それが、しゃるーるの美軸メソッドです。</p>
					</div>
				</div>
				<figure class="concept__photo" data-reveal>
					<Image
						src={studio}
						alt="木の床と鏡のある、しゃるーるのスタジオ"
						widths={[640, 960, 1400]}
						sizes="(max-width: 1080px) 92vw, 46vw"
						quality={76}
					/>
				</figure>
			</div>
		</section>

		<section class="section voice" id="voice">
			<div class="voice__head" data-reveal>
				<p class="eyebrow">Voice</p>
				<h2 class="heading">体験された方の声。</h2>
				<p class="voice__note">掲載している感想は、個人の体験です。身体の変化や痛みの改善を保証するものではありません。</p>
			</div>
			<div class="voice__layout">
				<figure class="voice__photo" data-reveal>
					<Image
						src={sessionTalk}
						alt="テーブルをはさんで姿勢の話をしている様子"
						widths={[480, 800, 1200]}
						sizes="(max-width: 1080px) 92vw, 40vw"
						quality={76}
					/>
					<figcaption><Icon name="ph:chat-circle-text" aria-hidden="true" /><span>体験の様子</span></figcaption>
				</figure>
				<div class="voice__quotes">
					<figure class="voice__card" data-reveal>
						<div class="voice__card-head">
							<span class="voice__badge">体験レビュー <span>01</span></span>
							<Icon name="ph:quotes" aria-hidden="true" />
						</div>
						<h3 class="voice__title">自分で姿勢を思い出そうという気持ちに。</h3>
						<blockquote class="voice__text">
							<p>
								マッサージに通っても、数日で戻る感じが気になっていました。重心や姿勢の癖を知るようになってから、自分で姿勢を思い出そうという気持ちになりました。
							</p>
						</blockquote>
						<figcaption class="voice__author">
							<span class="voice__avatar" aria-hidden="true"><Icon name="ph:user-circle" /></span>
							<span class="voice__author-info"><span>会社員の方</span><small>個人の感想</small></span>
						</figcaption>
					</figure>
					<figure class="voice__card" data-reveal>
						<div class="voice__card-head">
							<span class="voice__badge">体験レビュー <span>02</span></span>
							<Icon name="ph:quotes" aria-hidden="true" />
						</div>
						<h3 class="voice__title">着替える時間が楽しみになっています。</h3>
						<blockquote class="voice__text">
							<p>
								試着室で自分の後ろ姿を見たことが、姿勢を意識するきっかけでした。肩や骨盤の位置を知るうち、服を選ぶときの見方が変わり、着替える時間が楽しみになっています。
							</p>
						</blockquote>
						<figcaption class="voice__author">
							<span class="voice__avatar" aria-hidden="true"><Icon name="ph:user-circle" /></span>
							<span class="voice__author-info"><span>体験された方</span><small>個人の感想</small></span>
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<section class="section profile" id="profile">
			<div class="profile__grid">
				<figure class="profile__photo" data-reveal>
					<Image
						src={profileScene}
						alt="指導中の代表が、斜め前からゲストと向き合っている様子"
						widths={[480, 800, 1200]}
						sizes="(max-width: 1080px) 92vw, 42vw"
						quality={76}
					/>
				</figure>
				<div class="profile__copy" data-reveal>
					<p class="eyebrow">Profile</p>
					<h2 class="heading">私が、しゃるーるを<br />始めた理由。</h2>
					<p class="profile__name">
						<strong>Aya Nakagawa</strong>
						<span>代表 / 姿勢改善専門家　トレーナー歴15年</span>
					</p>
					<div class="profile__body">
						<p>
							子育てと仕事に追われ、身体のことはいつも後回し。<br />
							「頑張れば何とかなる」と、私自身も身体を追い込んできました。
						</p>
						<p>
							けれど、疲れや不調、姿勢や体型の変化を感じ、<br />
							「このまま頑張り続けるだけでいいのかな」と立ち止まりました。
						</p>
						<p>
							そこで出会ったのが、姿勢や重心を見直し、身体の使い方を学ぶこと。<br />
							身体が動きやすくなるにつれ、気持ちまで明るくなる感覚がありました。
						</p>
						<p>
							この経験を、同じように悩む方へ届けたい。<br />
							きれいな姿勢も、楽に動ける身体も目指せるよう、一人ひとりに寄り添いたい。<br />
							そんな想いで、しゃるーるを始めました。
						</p>
						<p>
							しゃるーるは、フランス語で「温かさ」。<br />
							ここが、身体をいたわり、ほっとできる場所であってほしい。
						</p>
						<p>
							身体と心にゆとりが生まれ、その笑顔が家族や大切な人にも広がっていく。<br />
							そんな温かいつながりを、この場所から育んでいきたいと思っています。
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section receive" id="receive">
			<div class="receive__inner" data-reveal>
				<p class="eyebrow">How to receive</p>
				<h2 class="heading">特典の受け取り方。</h2>
				<p class="lead">ボタンの先は、すべて同じ公式LINEです。登録後、無料3大特典をご案内します。</p>
				<ol class="receive__steps">
					{
						receiveSteps.map((step) => (
							<li>
								<span>{step.num}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.text}</p>
								</div>
							</li>
						))
					}
				</ol>
				<figure class="receive__guide">
					<div class="receive__guide-crop">
						<Image
							src={giftGuide}
							alt="LINEを追加し、特典を受け取り、家で試す3つのステップ"
							widths={[640, 960, 1206]}
							sizes="(max-width: 767px) calc(100vw - 2.5rem), (max-width: 815px) calc(100vw - 5rem), 46rem"
							quality={80}
						/>
					</div>
				</figure>
				<LineCta />
				<div class="receive__hp">
					<p>サロンのご案内は、ホームページをご覧ください。</p>
					<a class="btn btn--ghost" href={hpUrl} target="_blank" rel="noopener noreferrer">ホームページを見る</a>
				</div>
				<aside class="receive__scope">
					<p class="receive__scope-title">特典のご用意・配布について</p>
					<p>
						弊社では、特典そのものの作成および公式LINEでの特典送付・配布設定は対応いたしかねます。こちらはお客様側でのご準備・ご対応をお願いいたします。
					</p>
				</aside>
			</div>
		</section>
	</main>
</Layout>
