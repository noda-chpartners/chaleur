---
import { Icon } from 'astro-icon/components';
import LineCta from './LineCta.astro';

const links = [
	{ href: '#concerns', label: 'お悩み' },
	{ href: '#gifts', label: '無料特典' },
	{ href: '#home', label: '取り組み方' },
	{ href: '#concept', label: '考え方' },
	{ href: '#voice', label: 'お客様の声' },
	{ href: '#profile', label: 'プロフィール' },
];
---

<header class="site-header" data-header>
	<div class="site-header__inner">
		<a class="site-header__mark" href="#top">Chaleur</a>
		<nav class="site-header__nav" aria-label="ページ内メニュー">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<button class="site-header__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="drawer">
			<span class="sr-only">メニュー</span>
			<span class="site-header__icon site-header__icon--open" aria-hidden="true">
				<Icon name="ph:list" />
			</span>
			<span class="site-header__icon site-header__icon--close" aria-hidden="true">
				<Icon name="ph:x" />
			</span>
		</button>
	</div>
</header>

<div class="drawer" id="drawer" data-drawer>
	<div class="drawer__panel">
		<nav class="drawer__nav" aria-label="モバイルメニュー">
			{links.map((link) => <a href={link.href} data-menu-link>{link.label}</a>)}
		</nav>
		<div class="drawer__actions">
			<LineCta />
			<a class="drawer__tel" href="tel:0484440647">048-444-0647</a>
		</div>
	</div>
</div>

<style lang="scss">
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.drawer__tel {
		justify-self: center;
		color: #6a5146;
		font-size: 1rem;
		letter-spacing: 0.08em;
	}
</style>
